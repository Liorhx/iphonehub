# ========================================================
# VERCEL ENVIRONMENT VARIABLES (Frontend Deployment)
# Paste these in: Vercel Project Settings > Environment Variables
# ========================================================

# 1. Application URL (Your Vercel production domain)
NEXTAUTH_URL=https://your-iphonehub.vercel.app
NEXT_PUBLIC_APP_URL=https://your-iphonehub.vercel.app

# 2. Render Backend URL (Connects Vercel frontend to Render backend)
# All /api/* calls from Vercel will be seamlessly forwarded here
RENDER_BACKEND_URL=https://iphonehub-backend.onrender.com

# 3. NextAuth Session Secret (Generate any 32-character random string)
NEXTAUTH_SECRET=generate_a_random_32_character_secret_key_here

# 4. Google OAuth (Client-side trigger)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 5. Razorpay Key ID (Public key for checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyId

# 6. Cloudinary (Public Cloud Name for image display)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# 7. Admin Configuration
ADMIN_EMAILS=yadav962160@gmail.com

# 8. Email Dispatch (To receive real 2FA OTP codes on your admin email)
# For Gmail: create a 16-character Google App Password at myaccount.google.com/apppasswords
SMTP_USER=yadav962160@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Or if using Resend (free 3000 emails/month, fastest on Vercel):
# RESEND_API_KEY=re_your_api_key

