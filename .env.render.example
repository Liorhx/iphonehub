# ========================================================
# RENDER ENVIRONMENT VARIABLES (Backend Deployment)
# Paste these in: Render Dashboard > Environment > Add Environment Variable
# ========================================================

# 1. Environment
NODE_ENV=production

# 2. Database Connection (MongoDB Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/iphonehub?retryWrites=true&w=majority

# 3. NextAuth Configuration (Must match Vercel NEXTAUTH_SECRET and frontend URL)
NEXTAUTH_URL=https://your-iphonehub.vercel.app
NEXTAUTH_SECRET=generate_a_random_32_character_secret_key_here

# 4. Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Razorpay Secret & Public Keys (For server-side payment verification)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# 6. Cloudinary (For admin product image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. Admin Configuration (Comma-separated admin emails)
ADMIN_EMAILS=yadav962160@gmail.com

